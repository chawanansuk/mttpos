{
  "name": "@medee/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate": "prisma migrate dev",
    "reset": "prisma db push --force-reset --accept-data-loss && pnpm seed",
    "seed": "tsx seed/index.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "build": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@medee/domain": "workspace:*",
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.1"
  }
}
