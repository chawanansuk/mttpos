# ฐานข้อมูล
DATABASE_URL="postgresql://medee:medee@localhost:5432/medeepos?schema=public"

# ความปลอดภัย — เปลี่ยนก่อนใช้งานจริง
JWT_SECRET="เปลี่ยนค่านี้เป็นสตริงสุ่มยาว ๆ"
JWT_REFRESH_SECRET="เปลี่ยนค่านี้เป็นสตริงสุ่มยาว ๆ อีกอัน"
ACCESS_TOKEN_TTL="2h"
REFRESH_TOKEN_TTL_DAYS=30

# API
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=*

# เว็บ — ชี้ไปที่ API (เว้นว่างได้ถ้ารันผ่าน rewrite ของ Next)
API_URL="http://localhost:4000"

# ── Deploy บน Vercel ────────────────────────────────────────────────────────
# ไม่ต้องตั้ง API_URL / NEXT_PUBLIC_API_URL — เว็บจะให้บริการ /api/v1 เองในโปรเซสเดียวกัน
# ตั้งแค่ DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET
# DATABASE_URL ควรชี้ไปที่ connection pooler (Neon/Supabase pooler หรือ PgBouncer)
# เพราะ serverless เปิดหลายอินสแตนซ์พร้อมกัน ถ้าต่อตรงจะกิน connection จนเต็ม
